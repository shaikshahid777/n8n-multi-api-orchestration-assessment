    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "t1",
              "name": "transactionId",
              "value": "=TXN-{{ $now.toFormat(\"yyyyLLdd\") }}-{{ $execution.id }}-{{ Math.floor(Math.random() * 1000000) }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "513b00e8-18dd-4518-9c6a-1dc765d726dc",
      "name": "Generate Transaction ID",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Mock customer directory: map email -> customer ID\nconst directory = {\n  'jane.doe@example.com': 'CUST-1001',\n  'john.smith@example.com': 'CUST-1002',\n  'acme.support@example.com': 'CUST-2001',\n};\n\nconst email = String($json.customerEmail || '').trim().toLowerCase();\nconst customerId = directory[email] || 'CUST-UNKNOWN';\n\nreturn {\n  json: {\n    ...$json,\n    customerId,\n    customerFound: customerId !== 'CUST-UNKNOWN',\n  },\n};"
      },
      "id": "9c96b740-1b4f-4ca6-98c0-3e16e6dd8ebc",
      "name": "Customer Lookup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://httpbin.org/post",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ transactionId: $json.transactionId, customerId: $json.customerId, customerEmail: $json.customerEmail, subject: $json.subject, description: $json.description, priority: $json.priority, channel: $json.channel, createdAt: $json.createdAt }) }}",
        "options": {}
      },
      "id": "218fb873-dbcd-4a73-9ca7-7ba7c7cad9ea",
      "name": "Log Ticket to Mock DB API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        896,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "v1",
              "name": "dbStored",
              "value": "={{ $json.url ? true : false }}",
              "type": "boolean"
            },
            {
              "id": "v2",
              "name": "storedTransactionId",
              "value": "={{ $('Generate Transaction ID').item.json.transactionId }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "fc9c0f87-1a93-433e-a64f-28195fe6bf41",
      "name": "Verify DB Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1120,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://httpbin.org/post",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: \"Support ticket created\", transactionId: $('Generate Transaction ID').item.json.transactionId, customerId: $('Customer Lookup').item.json.customerId, to: $('Initialize Ticket Payload').item.json.customerEmail, subject: $('Initialize Ticket Payload').item.json.subject, priority: $('Initialize Ticket Payload').item.json.priority, dbStored: $json.dbStored }) }}",
        "options": {}
      },
      "id": "b09e960e-1135-44d2-b46f-86ab929f750f",
      "name": "Send Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1344,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const init = $(\"Initialize Ticket Payload\").first().json;\nconst txn = $(\"Generate Transaction ID\").first().json;\nconst lookup = $(\"Customer Lookup\").first().json;\nconst verify = $(\"Verify DB Response\").first().json;\nconst notify = $input.first().json;\n\nconst checks = {\n  ticketInitialized: Boolean(init.customerEmail && init.subject),\n  transactionIdGenerated: Boolean(txn.transactionId),\n  customerLookupResolved: Boolean(lookup.customerId),\n  databaseLogged: Boolean(verify.dbStored),\n  notificationSent: Boolean(notify && notify.url),\n};\n\nconst passed = Object.values(checks).every(Boolean);\n\nreturn [{\n  json: {\n    status: passed ? \"SUCCESS\" : \"FAILED\",\n    checks,\n    summary: {\n      transactionId: txn.transactionId,\n      customerId: lookup.customerId,\n      customerEmail: init.customerEmail,\n      priority: init.priority,\n    },\n  },\n}];"
      },
      "id": "ef993b10-cab4-479f-bc94-c4b9c1ae5baa",
      "name": "Validate Execution Flow",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        0
      ]
    }
  ],
